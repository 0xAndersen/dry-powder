# ops/relay/.env (git-ignored). The relay needs nothing secret; the push relay needs its VAPID key pair.

# Web Push: generate once with `node keeper/src/push.mjs keys` (from the repository root, after `npm ci` in keeper/).
# The private key signs every notification: keep it out of git, and rotate it by generating a new pair (browsers
# then have to subscribe again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach about this sender.
VAPID_SUBJECT=mailto:ops@example.com
# The app's origin(s), comma-separated; browsers on other sites cannot subscribe.
ALLOWED_ORIGINS=https://0xandersen.github.io

# Both: an RPC to use before the deployment file's (Arc's public RPCs are added automatically).
# RPC_URL=
# Behind a reverse proxy: count clients by X-Forwarded-For.
# TRUST_PROXY=1
# RELAY_PORT=8091
# PUSH_PORT=8092
