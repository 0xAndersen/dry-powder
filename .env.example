# Shared configuration for `docker compose up`. Copy to .env and fill in.

# From ops/output-testnet/addresses.json (ops runner) or contracts/deployments/5042002.json (forge script)
# engine -> PERP_ENGINE_ADDRESS, lens -> ENGINE_LENS_ADDRESS, vault -> HOUSE_VAULT_ADDRESS, token -> REWARD_TOKEN_ADDRESS,
# usdc -> USDC_ADDRESS (set COLLATERAL_IS_TEST=true and COLLATERAL_SYMBOL=tUSDC when it is TestUSDC)
PERP_ENGINE_ADDRESS=
ENGINE_LENS_ADDRESS=
HOUSE_VAULT_ADDRESS=
REWARD_TOKEN_ADDRESS=
# Optional: enables the Agents page (agentFactory in deployments/arc-testnet.json)
AGENT_FACTORY_ADDRESS=

# Legacy v1 keeper only (not needed for the frontend). Keeper hot wallet (0x-prefixed private key). Fund it with a little USDC on Arc for gas and Pyth fees.
# Keep only what it needs in this account and never reuse the deployer or owner key.
KEEPER_PRIVATE_KEY=

# Optional overrides (defaults target Arc Testnet)
# RPC_URL=https://rpc.testnet.arc.network
# CHAIN_ID=5042002
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
# HERMES_URL=https://hermes.pyth.network
# EXPLORER_URL=https://testnet.arcscan.app
# FRONTEND_PORT=3000
# DRY_RUN=false
# LOG_LEVEL=info

# USDC_ADDRESS=
# COLLATERAL_SYMBOL=tUSDC
# COLLATERAL_IS_TEST=true
# ORACLE_MODE=publisher
