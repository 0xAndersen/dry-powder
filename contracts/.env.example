# Used by foundry.toml ([rpc_endpoints] arc_testnet) and script/Deploy.s.sol.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Optional overrides for the deploy script (defaults shown)
# ORACLE_MODE=pyth           # "publisher" deploys a PublisherOracle and uses it in Pyth's place (testnet only)
# PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43   # pyth mode; required on any chain but Arc Testnet
# PUBLISHER_ADDRESS=         # publisher mode: first authorised price signer; defaults to the deployer
# COLLATERAL=usdc            # "test" deploys an open-mint TestUSDC and uses that (testnet only)
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# OWNER_ADDRESS=             # defaults to the deployer; otherwise the new owner must call acceptOwnership()
# WITHDRAW_LOCK_SECONDS=3600
# EPOCH_SECONDS=86400
# STREAM_SECONDS=86400
# MAX_PRICE_AGE_SECONDS=10
# FUTURE_EXPIRY=             # unix time; default: next Friday 08:00 UTC more than 24h away
