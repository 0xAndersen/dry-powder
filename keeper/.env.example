# Dry Powder keeper: price publisher + order execution + liquidations + settlement + vault epochs.

# Deployment: a JSON file with engine / lens / vault / pub (PublisherOracle) addresses, e.g. the
# deployments/arc-testnet.json written by the testnet deploy workflow, or set the addresses one by one.
DEPLOYMENT=../deployments/arc-testnet.json
# PERP_ENGINE_ADDRESS=
# ENGINE_LENS_ADDRESS=
# HOUSE_VAULT_ADDRESS=
# PUBLISHER_ORACLE_ADDRESS=
RPC_URL=https://rpc.testnet.arc.io
# Extra RPCs tried in order when one fails (on Arc Testnet the public providers are added automatically).
# RPC_URLS=https://rpc.quicknode.testnet.arc.io,https://rpc.drpc.testnet.arc.io
CHAIN_ID=5042002

# KEEPER_MODE=executor runs a second keeper beside the venue's: fills, liquidations, settlement and expiry sweeps
# against the prices already on-chain, with no publisher key and no exchange feeds. Anyone may run one; the
# execution fees go to whoever executes first.
# KEEPER_MODE=executor

# Keys (hot wallets holding only gas). Either both keys, or SEED (the ops runtime seed the deployment used).
# An executor-only keeper needs only KEEPER_KEY.
PUBLISHER_KEY=
KEEPER_KEY=
# SEED=
# Optional: tops the two up with native USDC when they drop under MIN_GAS_USDC (usually the deployer key).
# FUNDER_KEY=
MIN_GAS_USDC=1
TOP_UP_USDC=3

# Price pushes. A feed is pushed when older than the heartbeat, after a move of MOVE_BPS, or when an order,
# a liquidation or an expiry needs a newer price. Each push costs ~24k gas + ~21k per feed (~0.003 USDC for
# all six feeds at Arc's 20 gwei floor): 60 s is about 4 USDC a day.
HEARTBEAT_SECONDS=60
MOVE_BPS=5
# A Kraken ticker that has not changed for this long is a closed market and is never published.
STALE_FEED_MS=60000
KRAKEN_URL=https://api.kraken.com

TICK_MS=1500
BATCH_SIZE=20
# Settled dated markets: traders get this long to close at the settlement price before the keeper sweeps.
SETTLE_POSITIONS_DELAY_SECONDS=600
# Wait this long after a dated market expires before fixing its settlement price (anyone may do it earlier).
SETTLE_MARKET_DELAY_SECONDS=0
PRIORITY_FEE_GWEI=1
MIN_FEE_GWEI=25
# SETTLE_EPOCHS=1        # 0 leaves vault epochs to someone else
# RUN_SECONDS=21000   # stop cleanly after this long (scheduled runners)
# PORT=8080           # GET /health
# DRY_RUN=1
