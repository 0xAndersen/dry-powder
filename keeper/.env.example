# House Money keeper configuration.

# Required
PERP_ENGINE_ADDRESS=
# Private key of the keeper account (0x-prefixed). It needs a little USDC on Arc: USDC is the gas token
# and also pays the Pyth update fee. Use a dedicated hot wallet holding only what it needs.
KEEPER_PRIVATE_KEY=

# Optional: defaults shown
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002
PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
HERMES_URL=https://hermes.pyth.network

# How often to re-read open positions and orders from the chain.
REFRESH_INTERVAL_MS=2000
# How often to compare the latest prices against cached positions and orders.
TICK_INTERVAL_MS=250
# Maximum positions per liquidateBatch transaction.
LIQUIDATION_BATCH_SIZE=20
# Also execute limit / take-profit / stop-loss orders (earns each order's execution fee).
EXECUTE_ORDERS=true
# Tip added on top of the base fee to get ahead of other keepers, in gwei.
PRIORITY_FEE_GWEI=1
# Hard ceiling on maxFeePerGas, in gwei. Arc's base fee floor is 20 gwei.
MAX_FEE_GWEI=500
# Log what would be sent without sending anything.
DRY_RUN=false
# debug | info | warn | error
LOG_LEVEL=info
