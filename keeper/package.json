{
  "name": "arc-house-keeper",
  "version": "1.0.0",
  "private": true,
  "description": "Liquidation and order-execution keeper for the Arc House perpetuals protocol",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
