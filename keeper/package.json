{
  "name": "dry-powder-keeper",
  "version": "2.0.0",
  "private": true,
  "description": "Price publisher and keeper (fills, liquidations, settlement, vault epochs) for Dry Powder",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "dry-powder-keeper": "src/main.mjs"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "index": "node src/indexer.mjs",
    "relay": "node src/relay.mjs",
    "push": "node src/push.mjs",
    "push:keys": "node src/push.mjs keys",
    "prizes": "node ../ops/scripts/prizes.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "viem": "2.57.10"
  }
}
