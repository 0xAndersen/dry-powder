# Arc House frontend: runtime configuration.
# These are read by the server on every request (not baked in at build time),
# so one image can serve any deployment: `docker run --env-file .env -p 3000:3000 arc-house-frontend`.

# Required: deployed contract addresses
PERP_ENGINE_ADDRESS=
HOUSE_VAULT_ADDRESS=
REWARD_TOKEN_ADDRESS=

# Optional: defaults shown
USDC_ADDRESS=0x3600000000000000000000000000000000000000
PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
RPC_URL=https://rpc.testnet.arc.network
HERMES_URL=https://hermes.pyth.network
CHAIN_ID=5042002
EXPLORER_URL=https://testnet.arcscan.app
