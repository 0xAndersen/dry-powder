# Dry Powder frontend: runtime configuration for the Node server build (Docker).
# Read by the server on every request, never baked in at build time, so one image serves any deployment:
#   docker run --env-file .env -p 3000:3000 dry-powder-frontend
# The static bundle (npm run build:static) reads the same settings from config.json instead; see README.md.

# Required: deployed contract addresses
PERP_ENGINE_ADDRESS=
ENGINE_LENS_ADDRESS=
HOUSE_VAULT_ADDRESS=
REWARD_TOKEN_ADDRESS=

# Collateral token. Default is Arc's native USDC; point it at TestUSDC on a test deployment.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
COLLATERAL_SYMBOL=USDC
# true shows a "Get test funds" button that calls TestUSDC.mint(self, 10,000)
COLLATERAL_IS_TEST=false

# Network
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
EXPLORER_URL=https://explorer.testnet.arc.io

# Prices: "publisher" (on-chain PublisherOracle, tape from Kraken; Arc Testnet) or "pyth" (Hermes)
ORACLE_MODE=publisher
KRAKEN_URL=https://api.kraken.com
# Pyth mode only. The key is used from the browser, so it is visible to users.
HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
